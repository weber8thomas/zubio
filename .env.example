# Copier ce fichier en .env.local puis renseigner les valeurs.
# Ne jamais committer de vraies valeurs : .env* est ignoré par Git.

# URL du projet Supabase (Project Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Clé publique « anon » (Project Settings > API). Exposée au navigateur, protégée par la RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé « service_role » : SERVEUR UNIQUEMENT. Ne jamais la préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# URL publique de l'application (liens magiques, redirections).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Affiche la page /demo et ses boutons de connexion rapide (true/false).
NEXT_PUBLIC_DEMO_MODE=true

# Mot de passe des comptes de démo créés par supabase/seed.sql.
DEMO_PASSWORD=zubio-demo-2026

# Optionnel : active les réponses de l'agent support via l'API Mistral.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
